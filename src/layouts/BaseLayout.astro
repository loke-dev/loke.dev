---
import { ClientRouter } from 'astro:transitions'
import { TURNSTILE_SITE_ID } from '@/config/turnstile'
import { serializeJsonLd } from '@/utils/json-ld'
import Footer from '@/components/Footer.astro'
import Header from '@/components/Header.astro'
import Seo from '@/components/Seo.astro'
import '@/styles/global.css'
import { toIsoDate } from '@/utils/date'
import { SITE_DOMAIN } from '@/utils/meta'

interface Props {
  title: string
  description: string
  url?: string
  image?: string
  imageAlt?: string
  type?: 'website' | 'article'
  author?: string
  publishedTime?: string
  modifiedTime?: string
  keywords?: string | string[]
  noindex?: boolean
  loadTurnstile?: boolean
  preconnectSanity?: boolean
}

const {
  title,
  description,
  url,
  image,
  imageAlt,
  type,
  author,
  publishedTime,
  modifiedTime,
  keywords,
  noindex,
  loadTurnstile = false,
  preconnectSanity = false,
} = Astro.props
const canonical = new URL(url ?? Astro.url.href)
canonical.search = ''
canonical.hash = ''
const canonicalUrl = canonical.href
const normalizedModifiedTime = toIsoDate(modifiedTime)
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#121212" />
    <Seo
      title={title}
      description={description}
      url={canonicalUrl}
      image={image}
      imageAlt={imageAlt}
      type={type}
      author={author}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      keywords={keywords}
      noindex={noindex}
    />
    <slot name="head" />
    {
      preconnectSanity && (
        <>
          <link rel="dns-prefetch" href="https://cdn.sanity.io" />
          <link rel="preconnect" href="https://cdn.sanity.io" crossorigin />
        </>
      )
    }
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Loke.dev"
      href="/rss.xml"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/brand/workshop-signal/loke-signal-mark.svg?v=2"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32x32.png?v=2"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-16x16.png?v=2"
    />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="/manifest.json" />
    <script
      async
      data-project-id="f08c2acd-2566-41d9-9af5-c34505ca3a1c"
      src="https://api.muroanalytics.com/muro.js"></script>
    {
      loadTurnstile && (
        <script
          id="turnstile-script"
          is:inline
          src="https://challenges.cloudflare.com/turnstile/v0/api.js"
          async
          defer
        />
      )
    }
    <script
      is:inline
      type="application/ld+json"
      set:html={serializeJsonLd({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Person',
            '@id': `${SITE_DOMAIN}/#person`,
            name: 'Loke',
            url: `${SITE_DOMAIN}/about`,
            image: `${SITE_DOMAIN}/brand/workshop-signal/loke-profile-portrait-preview.webp`,
            sameAs: ['https://github.com/loke-dev', 'https://x.com/loke_dev'],
          },
          {
            '@type': 'WebSite',
            '@id': `${SITE_DOMAIN}/#website`,
            url: SITE_DOMAIN,
            name: 'Loke.dev',
            publisher: { '@id': `${SITE_DOMAIN}/#person` },
            potentialAction: {
              '@type': 'SearchAction',
              target: {
                '@type': 'EntryPoint',
                urlTemplate: `${SITE_DOMAIN}/search?q={search_term_string}`,
              },
              'query-input': 'required name=search_term_string',
            },
          },
          {
            '@type': 'WebPage',
            '@id': `${canonicalUrl}#webpage`,
            url: canonicalUrl,
            name: title,
            description,
            isPartOf: { '@id': `${SITE_DOMAIN}/#website` },
            about: { '@id': `${SITE_DOMAIN}/#person` },
            inLanguage: 'en',
            ...(normalizedModifiedTime
              ? { dateModified: normalizedModifiedTime }
              : {}),
          },
        ],
      })}
    />
    <ClientRouter />
  </head>
  <body class="bg-background text-foreground min-h-screen">
    <a
      href="#main-content"
      class="bg-background text-foreground focus-visible:ring-ring focus-visible:ring-offset-background sr-only fixed top-4 left-4 z-[100] rounded-md px-4 py-2 text-sm font-medium shadow-lg focus:not-sr-only focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none"
    >
      Skip to content
    </a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {
      loadTurnstile && (
        <div id="env-data" data-turnstile-key={TURNSTILE_SITE_ID} hidden />
      )
    }
  </body>
</html>
