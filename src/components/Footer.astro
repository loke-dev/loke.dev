---
const year = new Date().getFullYear()

const exploreLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/tools', label: 'Tools' },
  { href: '/blog', label: 'Blog' },
  { href: '/topics', label: 'Topics' },
  { href: '/projects', label: 'Projects' },
  { href: '/contact', label: 'Contact' },
  { href: '/changelog', label: 'Changelog' },
]

const socialLinks = [
  {
    href: 'https://github.com/loke-dev',
    label: 'GitHub',
    description: 'Code & experiments',
  },
  {
    href: 'https://twitter.com/loke_dev',
    label: 'Twitter',
    description: 'Shorter thoughts',
  },
]

const feedsLinks = [
  { href: '/rss.xml', label: 'RSS feed', external: false },
  { href: '/privacy', label: 'Privacy', external: false },
  {
    href: '/affiliate-disclosure',
    label: 'Affiliate disclosure',
    external: false,
  },
  {
    href: 'https://github.com/loke-dev/loke.dev',
    label: 'Site source',
    external: true,
  },
] as const
---

<footer class="border-border/80 bg-muted/30 w-full border-t">
  <div class="container mx-auto max-w-6xl px-4 py-14 md:px-8 md:py-20">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4 lg:gap-10">
      <div class="lg:col-span-2">
        <a
          href="/"
          class="text-foreground inline-block text-2xl font-bold tracking-tight"
        >
          loke.dev
        </a>
        <p
          class="text-muted-foreground mt-4 max-w-md text-base leading-relaxed"
        >
          I build websites, write about dev stuff, and make small experiments.
          Built with Astro, Sanity, Cloudflare, and enough coffee.
        </p>
        <p class="text-muted-foreground mt-6 text-sm">
          © {year} Loke. All rights reserved.
        </p>
      </div>

      <div>
        <h2
          class="text-accent text-xs font-semibold tracking-[0.2em] uppercase"
        >
          Explore
        </h2>
        <ul class="mt-5 space-y-3">
          {
            exploreLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-foreground hover:text-accent text-base font-medium underline-offset-4 transition-colors hover:underline"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2
          class="text-accent text-xs font-semibold tracking-[0.2em] uppercase"
        >
          Connect
        </h2>
        <ul class="mt-5 space-y-4">
          {
            socialLinks.map((item) => (
              <li>
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group block"
                >
                  <span class="text-foreground group-hover:text-accent text-base font-medium underline-offset-4 transition-colors group-hover:underline">
                    {item.label}
                  </span>
                  <span class="text-muted-foreground mt-0.5 block text-sm">
                    {item.description}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div
      class="border-border/60 mt-14 flex flex-col gap-6 border-t pt-10 md:flex-row md:items-center md:justify-between"
    >
      <nav class="flex flex-wrap gap-x-6 gap-y-2" aria-label="Feeds and source">
        {
          feedsLinks.map((item) => (
            <a
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noopener noreferrer' : undefined}
              class="text-muted-foreground hover:text-accent text-sm font-medium underline-offset-4 transition-colors hover:underline"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <p class="text-muted-foreground text-sm">
        Thanks for visiting. {' '}
        <a
          href="/contact"
          class="text-foreground hover:text-accent font-medium underline-offset-4 hover:underline"
        >
          say hello
        </a>
        {''} if you want to talk.
      </p>
    </div>
  </div>
</footer>
