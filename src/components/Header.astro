---
import { getAllTopics } from '@/utils/sanity.queries'
import HeaderSearch from '@/components/HeaderSearch'

const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/tools', label: 'Tools' },
  { href: '/projects', label: 'Projects' },
  { href: '/contact', label: 'Contact' },
]
const topics = await getAllTopics()
const pathname = Astro.url.pathname

function isCurrentPath(href: string): boolean {
  return pathname === href || pathname.startsWith(`${href}/`)
}
---

<header
  class="bg-background/95 supports-backdrop-filter:bg-background/60 sticky top-0 z-50 w-full border-b backdrop-blur"
>
  <div
    class="container mx-auto flex h-16 items-center justify-between px-4 md:px-8"
  >
    <a
      href="/"
      aria-current={pathname === '/' ? 'page' : undefined}
      class="flex items-center"
    >
      <span class="text-xl font-bold tracking-tight">loke.dev</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label="Main navigation">
      {
        navLinks.slice(0, 3).map(({ href, label }) => (
          <a
            href={href}
            aria-current={isCurrentPath(href) ? 'page' : undefined}
            class="nav-link-animate text-muted-foreground hover:text-accent text-sm font-medium transition-colors"
          >
            {label}
          </a>
        ))
      }
      <div class="group relative">
        <a
          href="/blog"
          class="nav-link-animate text-muted-foreground hover:text-accent inline-flex items-center gap-1 text-sm font-medium transition-colors"
          aria-current={isCurrentPath('/blog') ? 'page' : undefined}
        >
          Blog
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </a>
        <div
          class="invisible absolute top-full left-1/2 z-50 w-64 -translate-x-1/2 pt-3 opacity-0 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100"
        >
          <nav
            class="border-border bg-card rounded-lg border p-2 shadow-xl"
            aria-label="Blog topics"
          >
            <a
              href="/blog"
              aria-current={isCurrentPath('/blog') ? 'page' : undefined}
              class="text-foreground hover:bg-secondary block rounded-md px-3 py-2 text-sm font-medium transition-colors"
              >All posts</a
            >
            {topics.length > 0 && <div class="border-border my-1 border-t" />}
            {
              topics.map((topic) => (
                <a
                  href={`/topics/${topic.slug.current}`}
                  aria-current={
                    isCurrentPath(`/topics/${topic.slug.current}`)
                      ? 'page'
                      : undefined
                  }
                  class="text-muted-foreground hover:bg-secondary hover:text-foreground block rounded-md px-3 py-2 text-sm transition-colors"
                >
                  {topic.title}
                </a>
              ))
            }
          </nav>
        </div>
      </div>
      {
        navLinks.slice(3).map(({ href, label }) => (
          <a
            href={href}
            aria-current={isCurrentPath(href) ? 'page' : undefined}
            class="nav-link-animate text-muted-foreground hover:text-accent text-sm font-medium transition-colors"
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-0.5">
      <HeaderSearch client:load />
      <div id="mobile-nav-root" class="md:hidden">
        <button
          type="button"
          data-mobile-nav-open
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-nav-dialog"
          class="text-muted-foreground hover:text-foreground inline-grid h-11 w-11 place-items-center"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>

        <dialog
          id="mobile-nav-dialog"
          aria-modal="true"
          aria-label="Navigation menu"
          class="mobile-menu-dialog bg-background fixed inset-0 m-0 ml-auto h-full w-3/4 max-w-sm border-l p-6 shadow-lg"
        >
          <button
            type="button"
            data-mobile-nav-close
            aria-label="Close navigation menu"
            class="text-muted-foreground hover:text-foreground absolute top-4 right-4 inline-grid h-11 w-11 place-items-center"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>

          <nav class="mt-8 flex flex-col gap-6" aria-label="Mobile navigation">
            {
              navLinks.slice(0, 3).map(({ href, label }) => (
                <a
                  href={href}
                  aria-current={isCurrentPath(href) ? 'page' : undefined}
                  class="nav-link-animate text-muted-foreground hover:text-accent text-base font-medium transition-colors"
                >
                  {label}
                </a>
              ))
            }
            <div class="-mt-2">
              <a
                href="/blog"
                aria-current={isCurrentPath('/blog') ? 'page' : undefined}
                class="nav-link-animate text-muted-foreground hover:text-accent text-base font-medium transition-colors"
                >Blog</a
              >
              {
                topics.length > 0 && (
                  <details class="mt-2">
                    <summary class="text-muted-foreground marker:text-accent cursor-pointer text-sm">
                      Topics
                    </summary>
                    <div class="border-border mt-3 flex flex-col gap-3 border-l pl-4">
                      <a
                        href="/blog"
                        aria-current={
                          isCurrentPath('/blog') ? 'page' : undefined
                        }
                        class="text-foreground hover:text-accent text-sm font-medium"
                      >
                        All posts
                      </a>
                      {topics.map((topic) => (
                        <a
                          href={`/topics/${topic.slug.current}`}
                          aria-current={
                            isCurrentPath(`/topics/${topic.slug.current}`)
                              ? 'page'
                              : undefined
                          }
                          class="text-muted-foreground hover:text-accent text-sm"
                        >
                          {topic.title}
                        </a>
                      ))}
                    </div>
                  </details>
                )
              }
            </div>
            {
              navLinks.slice(3).map(({ href, label }) => (
                <a
                  href={href}
                  aria-current={isCurrentPath(href) ? 'page' : undefined}
                  class="nav-link-animate text-muted-foreground hover:text-accent text-base font-medium transition-colors"
                >
                  {label}
                </a>
              ))
            }
          </nav>
        </dialog>
      </div>
    </div>
  </div>
</header>

<script>
  import { setupMobileMenu } from '@/scripts/mobile-menu'

  setupMobileMenu()
  document.addEventListener('astro:after-swap', setupMobileMenu)
</script>
