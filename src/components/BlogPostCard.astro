---
import {
  formatDate,
  getSanityImageSrcSet,
  getSanityImageUrl,
} from '@/lib/sanity/helpers'
import { getPostUpdatedDisplay } from '@/lib/sanity/post-display'
import type { PostListItem } from '@/lib/sanity/types'

interface Props {
  post: PostListItem
  imageWidth?: number
  imageHeight?: number
  priority?: boolean
}

const {
  post,
  imageWidth = 600,
  imageHeight = 338,
  priority = false,
} = Astro.props

const listQuality = 72
const srcWidths = [
  Math.round(imageWidth / 2),
  imageWidth,
  Math.round(imageWidth * 1.5),
]
const imageUrl = getSanityImageUrl(
  post.image,
  imageWidth,
  imageHeight,
  listQuality
)
const srcSet = getSanityImageSrcSet(
  post.image,
  srcWidths,
  imageHeight,
  listQuality,
  imageWidth
)
const updatedDisplay = getPostUpdatedDisplay(post)
---

<article
  class="workshop-card surface-interactive group hover:border-accent/35 flex h-full flex-col overflow-hidden transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-0.5 hover:shadow-[0_20px_50px_-28px_oklch(72%_0.16_70/0.28)]"
>
  <a
    href={`/blog/${post.slug.current}`}
    data-astro-prefetch="hover"
    class="flex flex-1 flex-col"
  >
    {
      imageUrl && (
        <div class="bg-muted aspect-video w-full overflow-hidden">
          <img
            src={imageUrl}
            srcset={srcSet || undefined}
            sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
            alt=""
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : undefined}
            decoding="async"
            width={imageWidth}
            height={imageHeight}
            class="h-full w-full object-cover"
          />
        </div>
      )
    }
    <div class="flex flex-1 flex-col p-6 pb-3">
      <div
        class="text-muted-foreground mb-2 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-sm"
      >
        <time datetime={post.date}>{formatDate(post.date)}</time>
        {
          post.readingTime ? (
            <>
              <span aria-hidden="true">·</span>
              <span>{post.readingTime} min read</span>
            </>
          ) : null
        }
        {
          updatedDisplay ? (
            <>
              <span aria-hidden="true">·</span>
              <span>
                Updated{' '}
                <time datetime={updatedDisplay.datetime}>
                  {updatedDisplay.label}
                </time>
              </span>
            </>
          ) : null
        }
      </div>
      <h2 class="mb-2 text-xl font-bold tracking-tight group-hover:underline">
        {post.title}
      </h2>
      <p class="text-muted-foreground line-clamp-3 flex-1">
        {post.description}
      </p>
      <div class="mt-4">
        <span
          class="text-primary inline-flex items-center gap-1 text-sm font-medium group-hover:underline"
        >
          Read article
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </span>
      </div>
    </div>
  </a>
  {
    post.topics?.length > 0 && (
      <div class="flex flex-wrap gap-1 px-6 pt-1 pb-6">
        {post.topics.map((topic) => (
          <a
            href={`/topics/${topic.slug.current}`}
            class="bg-secondary text-secondary-foreground inline-flex min-h-6 items-center rounded-full px-2 py-1 text-xs hover:underline"
          >
            {topic.title}
          </a>
        ))}
      </div>
    )
  }
</article>
