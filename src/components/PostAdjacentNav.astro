---
import type { PostListItem } from '@/lib/sanity/types'

interface Props {
  prev: PostListItem | null
  next: PostListItem | null
}

const { prev, next } = Astro.props
---

{
  (prev || next) && (
    <nav
      class="not-prose mt-12 grid gap-4 sm:grid-cols-2"
      aria-label="Adjacent posts"
    >
      {prev ? (
        <a
          href={`/blog/${prev.slug.current}`}
          data-astro-prefetch="hover"
          class="surface-adjacent group border-border bg-card/80 hover:border-accent/45 focus-visible:outline-accent flex flex-col rounded-xl border p-5 transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-0.5 hover:shadow-[0_20px_48px_-24px_oklch(72%_0.18_70/0.35)] focus-visible:outline-2 focus-visible:outline-offset-2"
        >
          <span class="text-accent text-xs font-medium tracking-wider uppercase">
            Previous
          </span>
          <span class="text-foreground group-hover:text-accent mt-2 text-base font-semibold transition-colors">
            {prev.title}
          </span>
        </a>
      ) : (
        <span class="hidden sm:block" />
      )}
      {next ? (
        <a
          href={`/blog/${next.slug.current}`}
          data-astro-prefetch="hover"
          class="surface-adjacent group border-border bg-card/80 hover:border-accent/45 focus-visible:outline-accent flex flex-col rounded-xl border p-5 text-right transition-[transform,box-shadow,border-color] duration-200 hover:-translate-y-0.5 hover:shadow-[0_20px_48px_-24px_oklch(72%_0.18_70/0.35)] focus-visible:outline-2 focus-visible:outline-offset-2 sm:col-start-2"
        >
          <span class="text-accent text-xs font-medium tracking-wider uppercase">
            Next
          </span>
          <span class="text-foreground group-hover:text-accent mt-2 text-base font-semibold transition-colors">
            {next.title}
          </span>
        </a>
      ) : (
        <span class="hidden sm:col-start-2 sm:block" />
      )}
    </nav>
  )
}
