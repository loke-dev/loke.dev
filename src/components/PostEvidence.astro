---
import { safeExternalUrl } from '@/utils/external-url'
import type {
  PostReproduction,
  PostSource,
  VersionScope,
} from '@/lib/sanity/types'

interface Props {
  sources?: PostSource[]
  reproduction?: PostReproduction
  versionScope?: VersionScope
}

const { reproduction, versionScope } = Astro.props
const sources = Astro.props.sources ?? []
const reproductionUrl = safeExternalUrl(reproduction?.repository)
const sourceLinks = sources.flatMap((source) => {
  const url = safeExternalUrl(source.url)
  return url ? [{ ...source, url }] : []
})

const versions = (versionScope?.versions ?? []).filter(
  (item) =>
    Boolean(item.technology?.trim()) &&
    Boolean(item.version?.trim()) &&
    !['current', 'tool-agnostic workflow'].includes(item.version.trim())
)
const hasTestScope = versions.length > 0
const hasReproduction = Boolean(
  reproduction &&
  (reproductionUrl ||
    reproduction.ref ||
    reproduction.setupCommand ||
    reproduction.verificationCommand)
)
const hasEvidence = sourceLinks.length > 0 || hasReproduction || hasTestScope
---

{
  hasEvidence && (
    <section
      class="not-prose mt-14 space-y-6"
      aria-label="Article evidence and sources"
    >
      {hasTestScope && (
        <aside
          class="border-border bg-card flex flex-wrap items-center gap-x-3 gap-y-2 rounded-lg border px-4 py-3 text-sm"
          aria-label="Tested with"
        >
          <span class="text-foreground font-medium">Tested with</span>
          <ul class="flex flex-wrap gap-2">
            {versions.map((item) => (
              <li class="bg-secondary text-secondary-foreground rounded-md px-2 py-1">
                <span>{item.technology}</span>
                <span aria-hidden="true"> · </span>
                <span>{item.version}</span>
              </li>
            ))}
          </ul>
          {versionScope?.testedAt && (
            <span class="text-muted-foreground">
              Verified {versionScope.testedAt}
            </span>
          )}
        </aside>
      )}
      {reproduction && hasReproduction && (
        <div class="border-accent/35 bg-accent/8 rounded-xl border p-5">
          <h2 class="text-lg font-semibold">Reproduce the example</h2>
          {reproductionUrl ? (
            <a
              class="text-accent mt-2 inline-block font-medium underline underline-offset-4"
              href={reproductionUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Open the repository (opens in new tab)"
            >
              Open the repository
            </a>
          ) : null}
          {reproduction.ref ? (
            <p class="text-muted-foreground mt-2 text-sm">
              Reference: <code>{reproduction.ref}</code>
            </p>
          ) : null}
          {reproduction.setupCommand ? (
            <pre class="bg-background mt-3 overflow-x-auto rounded p-3 text-sm">
              <code>{reproduction.setupCommand}</code>
            </pre>
          ) : null}
          {reproduction.verificationCommand ? (
            <pre class="bg-background mt-3 overflow-x-auto rounded p-3 text-sm">
              <code>{reproduction.verificationCommand}</code>
            </pre>
          ) : null}
        </div>
      )}
      {sourceLinks.length > 0 && (
        <div class="border-border bg-card rounded-xl border p-5">
          <h2 class="text-lg font-semibold">Sources and further reading</h2>
          <ol class="mt-4 space-y-3">
            {sourceLinks.map((source) => (
              <li>
                <a
                  href={source.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${source.title} (opens in new tab)`}
                  class="decoration-accent/50 hover:text-accent font-medium underline underline-offset-4"
                >
                  {source.title}
                </a>
                {source.publisher ? (
                  <span class="text-muted-foreground">
                    {' '}
                    · {source.publisher}
                  </span>
                ) : null}
              </li>
            ))}
          </ol>
        </div>
      )}
    </section>
  )
}
