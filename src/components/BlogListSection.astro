---
import type { BlogPage, PostListItem } from '@/utils/sanity.queries'
import BlogPostCard from '@/components/BlogPostCard.astro'
import Pagination from '@/components/Pagination.astro'

interface Props {
  page: BlogPage
  posts: PostListItem[]
  currentPage: number
  totalPages: number
}

const { page, posts, currentPage, totalPages } = Astro.props
---

<div class="workshop-page max-w-6xl">
  <section class="grid gap-8 md:grid-cols-[1fr_0.8fr] md:items-end">
    <div>
      <p class="workshop-label">Field notes / The archive</p><h1
        class="workshop-heading mt-5"
      >
        {page.title}
      </h1>
    </div>
    <p class="text-muted-foreground max-w-xl text-lg leading-relaxed">
      {page.description}
    </p>
  </section>

  {
    posts.length === 0 ? (
      <div class="workshop-card mt-12 p-8 text-center">
        <h2 class="mb-2 text-xl font-semibold">
          {page.emptyStateTitle ?? 'No posts yet'}
        </h2>
        <p class="text-muted-foreground">
          {page.emptyStateDescription ?? 'Check back soon for new articles!'}
        </p>
      </div>
    ) : (
      <>
        <div class="workshop-rule mt-14 grid gap-6 pt-10 sm:grid-cols-2">
          {posts.map((post, index) => (
            <BlogPostCard post={post} priority={index === 0} />
          ))}
        </div>

        <Pagination currentPage={currentPage} totalPages={totalPages} />
      </>
    )
  }
</div>
