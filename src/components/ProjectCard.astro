---
import { safeExternalUrl } from '@/utils/external-url'
import { getSanityImageSrcSet, getSanityImageUrl } from '@/lib/sanity/helpers'
import type { Project } from '@/lib/sanity/types'

interface Props {
  project: Project
  featured?: boolean
  template?: boolean
  priority?: boolean
}

const {
  project,
  featured = false,
  template = false,
  priority = false,
} = Astro.props

const width = featured ? 1000 : 760
const height = featured ? 620 : 500
const listQuality = 72
const projectUrl = safeExternalUrl(project.url)
const githubUrl = safeExternalUrl(project.github)
const srcWidths = [Math.round(width / 2), width, Math.round(width * 1.5)]
const imageUrl = getSanityImageUrl(project.image, width, height, listQuality)
const srcSet = getSanityImageSrcSet(
  project.image,
  srcWidths,
  height,
  listQuality,
  width
)
const projectLinkLabel = template ? 'Live preview' : 'Visit project'
const sourceLinkLabel = template ? 'View source' : 'GitHub'
---

<article
  class={`workshop-card surface-interactive group relative overflow-hidden transition-[transform,border-color,box-shadow] hover:-translate-y-1 hover:border-accent/45 hover:shadow-[0_24px_60px_-32px_oklch(72%_0.16_70/0.36)] ${featured ? 'flex w-full flex-col lg:flex-row' : 'flex h-full flex-col'} ${template ? 'bg-gradient-to-b from-card via-card to-accent/5' : ''}`}
>
  {
    imageUrl && (
      <div
        class={`bg-secondary relative w-full overflow-hidden ${featured ? 'aspect-[16/10] lg:aspect-auto lg:h-auto lg:w-[52%]' : 'aspect-[16/10]'}`}
      >
        {template && (
          <div class="from-accent to-accent absolute inset-x-0 top-0 z-10 h-1 bg-gradient-to-r via-orange-300" />
        )}
        <img
          src={imageUrl}
          srcset={srcSet || undefined}
          sizes={
            featured
              ? '(min-width: 1024px) 50vw, 100vw'
              : '(min-width: 1280px) 45vw, (min-width: 768px) 48vw, 100vw'
          }
          alt={project.imageAlt || project.image?.alt || project.title}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          decoding="async"
          width={width}
          height={height}
          class="h-full w-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.025]"
        />
      </div>
    )
  }
  {
    !imageUrl && (
      <div
        class={`signal-grid relative overflow-hidden bg-[#171715] ${featured ? 'min-h-56 lg:min-h-0 lg:w-[52%]' : 'aspect-[16/10]'}`}
      >
        <img
          src="/brand/workshop-signal/illustrations/signal-target.svg"
          alt=""
          aria-hidden="true"
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          width="640"
          height="420"
          class="absolute inset-0 h-full w-full object-cover opacity-90 transition-transform duration-500 group-hover:scale-[1.025]"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#121212]/55 via-transparent to-transparent" />
        <div class="relative flex h-full items-end p-6">
          <span class="border-accent/35 bg-background/70 text-foreground rounded-full border px-3 py-1 text-xs font-semibold tracking-[0.16em] uppercase backdrop-blur">
            {template ? 'Template' : 'Project note'}
          </span>
        </div>
      </div>
    )
  }

  <div class={`flex flex-col ${featured ? 'lg:w-[48%]' : 'w-full'}`}>
    <div class="p-6 pb-2 md:p-7 md:pb-2">
      {
        template && (
          <p class="text-accent mb-3 text-xs font-semibold tracking-[0.18em] uppercase">
            Template
          </p>
        )
      }
      <h3
        class={`font-semibold tracking-tight ${featured ? 'text-2xl md:text-3xl' : 'text-xl md:text-2xl'}`}
      >
        {project.title}
      </h3>
    </div>

    <div class="flex-1 px-6 pb-5 md:px-7">
      <p
        class={`mb-5 leading-relaxed text-muted-foreground ${featured ? 'text-base md:text-lg' : 'text-sm md:text-base'}`}
      >
        {project.description}
      </p>

      {
        project.technologies?.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {project.technologies.map((tech) => (
              <span class="bg-secondary text-secondary-foreground rounded-full px-2.5 py-0.5 text-xs font-medium">
                {tech}
              </span>
            ))}
          </div>
        )
      }
    </div>

    <div class="mt-auto flex flex-wrap gap-3 px-6 pb-6 md:px-7 md:pb-7">
      {
        projectUrl && (
          <a
            href={projectUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${projectLinkLabel}: ${project.title} (opens in new tab)`}
            class="bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center justify-center rounded-md px-4 py-2 text-sm font-medium transition-colors"
          >
            {template ? 'Live preview' : 'Visit project'}
          </a>
        )
      }
      {
        githubUrl && (
          <a
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${sourceLinkLabel}: ${project.title} (opens in new tab)`}
            class="border-input bg-background hover:bg-secondary inline-flex items-center justify-center rounded-md border px-4 py-2 text-sm font-medium transition-colors"
          >
            {template ? 'View source' : 'GitHub'}
          </a>
        )
      }
    </div>
  </div>
</article>
