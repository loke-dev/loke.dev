---
interface Props {
  currentPage: number
  totalPages: number
  basePath?: string
}

const { currentPage, totalPages, basePath = '/blog' } = Astro.props
const prevUrl =
  currentPage > 1
    ? currentPage === 2
      ? basePath
      : `${basePath}/page/${currentPage - 1}`
    : null
const nextUrl =
  currentPage < totalPages
    ? currentPage === 1
      ? `${basePath}/page/2`
      : `${basePath}/page/${currentPage + 1}`
    : null
---

{
  totalPages > 1 && (
    <nav
      class="mt-12 flex items-center justify-center gap-4"
      aria-label="Pagination"
    >
      {prevUrl ? (
        <a
          href={prevUrl}
          class="border-input bg-background hover:bg-secondary inline-flex h-9 w-9 items-center justify-center rounded-md border text-sm transition-colors"
          aria-label="Previous page"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </a>
      ) : (
        <span
          class="pointer-events-none inline-flex h-9 w-9 items-center justify-center rounded-md border border-transparent text-sm opacity-50"
          aria-disabled="true"
          aria-label="Previous page"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </span>
      )}

      <span class="text-muted-foreground text-sm">
        Page {currentPage} of {totalPages}
      </span>

      {nextUrl ? (
        <a
          href={nextUrl}
          class="border-input bg-background hover:bg-secondary inline-flex h-9 w-9 items-center justify-center rounded-md border text-sm transition-colors"
          aria-label="Next page"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 18l6-6-6-6" />
          </svg>
        </a>
      ) : (
        <span
          class="pointer-events-none inline-flex h-9 w-9 items-center justify-center rounded-md border border-transparent text-sm opacity-50"
          aria-disabled="true"
          aria-label="Next page"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 18l6-6-6-6" />
          </svg>
        </span>
      )}
    </nav>
  )
}
