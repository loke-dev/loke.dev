---
import { CACHE_CONTROL } from '@/utils/cache-control'
import { SITE_DOMAIN } from '@/utils/meta'
import { getAuthorBySlug, getPostsByAuthorSlug } from '@/utils/sanity.queries'
import BlogPostCard from '@/components/BlogPostCard.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getSanityImageUrl } from '@/lib/sanity/helpers'

export const prerender = false

Astro.response.headers.set('Cache-Control', CACHE_CONTROL.blogIndex)
const { slug } = Astro.params
const authorSlug = slug ?? ''
const author = authorSlug ? await getAuthorBySlug(authorSlug) : null
if (!author) {
  Astro.response.status = 404
  Astro.response.headers.set('Cache-Control', 'no-store')
}
const posts = author ? await getPostsByAuthorSlug(authorSlug) : []
const url = `${SITE_DOMAIN}/authors/${authorSlug}`
const image = author ? getSanityImageUrl(author.image, 400, 400) : null
---

{
  author ? (
    <BaseLayout
      title={author.name}
      description={
        author.bio ?? `${author.name}'s practical development writing.`
      }
      url={url}
      image={image ?? undefined}
      preconnectSanity={true}
    >
      <section class="mx-auto max-w-6xl px-4 py-16">
        <div class="max-w-2xl">
          {image ? (
            <img
              src={image}
              width="160"
              height="160"
              alt={`Portrait of ${author.name}`}
              class="mb-6 h-24 w-24 rounded-full object-cover"
            />
          ) : null}
          <p class="text-accent text-sm font-semibold tracking-wider uppercase">
            Author
          </p>
          <h1 class="mt-2 text-4xl font-bold tracking-tight">{author.name}</h1>
          {author.role ? (
            <p class="text-muted-foreground mt-2 font-medium">{author.role}</p>
          ) : null}
          {author.bio ? (
            <p class="text-muted-foreground mt-4 text-lg">{author.bio}</p>
          ) : null}
          {author.sameAs?.length ? (
            <ul class="mt-5 flex flex-wrap gap-3">
              {author.sameAs.map((profile) => (
                <li>
                  <a
                    class="text-accent underline underline-offset-4"
                    href={profile}
                    target="_blank"
                    rel="me noopener noreferrer"
                  >
                    Profile
                  </a>
                </li>
              ))}
            </ul>
          ) : null}
        </div>
        <h2 class="mt-14 text-2xl font-bold">Maintained articles</h2>
        {posts.length ? (
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <BlogPostCard post={post} />
            ))}
          </div>
        ) : (
          <p class="text-muted-foreground mt-6">No published articles yet.</p>
        )}
      </section>
    </BaseLayout>
  ) : (
    <BaseLayout
      title="Author not found"
      description="This author profile does not exist or has been removed."
      url={url}
      noindex={true}
    >
      <section class="mx-auto max-w-2xl px-4 py-24 text-center">
        <p class="text-accent text-sm font-semibold tracking-wider uppercase">
          Error 404
        </p>
        <h1 class="mt-3 text-4xl font-bold">This author is not here.</h1>
        <p class="text-muted-foreground mt-4 text-lg">
          The profile may have moved or been removed. You can browse the current
          writing instead.
        </p>
        <a
          class="bg-primary text-primary-foreground mt-8 inline-flex rounded-md px-4 py-2 font-medium"
          href="/blog"
        >
          Browse the blog
        </a>
      </section>
    </BaseLayout>
  )
}
