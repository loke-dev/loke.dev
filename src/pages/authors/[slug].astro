---
import { CACHE_CONTROL } from '@/utils/cache-control'
import { latestIsoDate } from '@/utils/date'
import { safeExternalUrl } from '@/utils/external-url'
import { serializeJsonLd } from '@/utils/json-ld'
import { SITE_DOMAIN } from '@/utils/meta'
import { getAuthorBySlug, getPostsByAuthorSlug } from '@/utils/sanity.queries'
import BlogPostCard from '@/components/BlogPostCard.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getSanityImageUrl } from '@/lib/sanity/helpers'
import { urlFor } from '@/lib/sanity/image'

export const prerender = false

Astro.response.headers.set('Cache-Control', CACHE_CONTROL.blogIndex)
const { slug } = Astro.params
const authorSlug = slug ?? ''
let author: Awaited<ReturnType<typeof getAuthorBySlug>> = null
let authorUnavailable = false
try {
  author = authorSlug ? await getAuthorBySlug(authorSlug) : null
} catch {
  authorUnavailable = true
  Astro.response.status = 503
  Astro.response.headers.set('Cache-Control', 'no-store')
}
if (!author && !authorUnavailable) {
  Astro.response.status = 404
  Astro.response.headers.set('Cache-Control', 'no-store')
}
const posts = author ? await getPostsByAuthorSlug(authorSlug) : []
const url = `${SITE_DOMAIN}/authors/${authorSlug}`
const modifiedTime = author
  ? latestIsoDate([
      author._updatedAt,
      ...posts.flatMap((post) => [
        post.lastModified,
        post._updatedAt,
        post.date,
      ]),
    ])
  : undefined
const image = author ? getSanityImageUrl(author.image, 400, 400) : null
const ogImage = author?.image
  ? urlFor(author.image).width(400).height(400).quality(80).format('jpg').url()
  : null
const profileLinks =
  author?.sameAs?.flatMap((profile) => {
    const safeUrl = safeExternalUrl(profile)
    return safeUrl ? [safeUrl] : []
  }) ?? []
const breadcrumbSchema = author
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_DOMAIN },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Blog',
          item: `${SITE_DOMAIN}/blog`,
        },
        { '@type': 'ListItem', position: 3, name: author.name, item: url },
      ],
    }
  : null
const profileSchema = author
  ? {
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      mainEntity: {
        '@type': 'Person',
        '@id': url,
        name: author.name,
        url,
        ...(author.bio ? { description: author.bio } : {}),
        ...(author.role ? { jobTitle: author.role } : {}),
        ...(image ? { image } : {}),
        ...(profileLinks.length ? { sameAs: profileLinks } : {}),
      },
    }
  : null

function getProfileLabel(profile: string): string {
  try {
    const hostname = new URL(profile).hostname.replace(/^www\./, '')
    const knownNames: Record<string, string> = {
      'github.com': 'GitHub',
      'linkedin.com': 'LinkedIn',
      'x.com': 'X',
      'twitter.com': 'X',
    }

    return knownNames[hostname] ?? `Profile on ${hostname}`
  } catch {
    return 'Profile'
  }
}
---

{
  author && !authorUnavailable ? (
    <BaseLayout
      title={author.name}
      description={
        author.bio ?? `${author.name}'s practical development writing.`
      }
      url={url}
      image={ogImage ?? undefined}
      modifiedTime={modifiedTime}
      preconnectSanity={true}
    >
      <script
        is:inline
        type="application/ld+json"
        set:html={serializeJsonLd(breadcrumbSchema)}
      />
      <script
        is:inline
        type="application/ld+json"
        set:html={serializeJsonLd(profileSchema)}
      />
      <section class="mx-auto max-w-6xl px-4 py-16">
        <div class="max-w-2xl">
          {image ? (
            <img
              src={image}
              width="160"
              height="160"
              alt={`Portrait of ${author.name}`}
              class="mb-6 h-24 w-24 rounded-full object-cover"
            />
          ) : null}
          <p class="text-accent text-sm font-semibold tracking-wider uppercase">
            Author
          </p>
          <h1 class="mt-2 text-4xl font-bold tracking-tight">{author.name}</h1>
          {author.role ? (
            <p class="text-muted-foreground mt-2 font-medium">{author.role}</p>
          ) : null}
          {author.bio ? (
            <p class="text-muted-foreground mt-4 text-lg">{author.bio}</p>
          ) : null}
          {profileLinks.length ? (
            <ul class="mt-5 flex flex-wrap gap-3">
              {profileLinks.map((profile) => (
                <li>
                  <a
                    class="text-accent underline underline-offset-4"
                    href={profile}
                    target="_blank"
                    rel="me noopener noreferrer"
                  >
                    {getProfileLabel(profile)}
                  </a>
                </li>
              ))}
            </ul>
          ) : null}
        </div>
        <h2 class="mt-14 text-2xl font-bold">Maintained articles</h2>
        {posts.length ? (
          <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <BlogPostCard post={post} />
            ))}
          </div>
        ) : (
          <p class="text-muted-foreground mt-6">No published articles yet.</p>
        )}
      </section>
    </BaseLayout>
  ) : (
    <BaseLayout
      title={
        authorUnavailable
          ? 'Author temporarily unavailable'
          : 'Author not found'
      }
      description={
        authorUnavailable
          ? 'This author profile could not be loaded right now.'
          : 'This author profile does not exist or has been removed.'
      }
      url={url}
      noindex={true}
    >
      <section class="mx-auto max-w-2xl px-4 py-24 text-center">
        <p class="text-accent text-sm font-semibold tracking-wider uppercase">
          {authorUnavailable ? 'Try again soon' : 'Error 404'}
        </p>
        <h1 class="mt-3 text-4xl font-bold">
          {authorUnavailable
            ? 'This profile is taking a short break.'
            : 'This author is not here.'}
        </h1>
        <p class="text-muted-foreground mt-4 text-lg">
          {authorUnavailable
            ? 'The content service did not respond. Please try again in a moment.'
            : 'The profile may have moved or been removed. You can browse the current writing instead.'}
        </p>
        <a
          class="bg-primary text-primary-foreground mt-8 inline-flex rounded-md px-4 py-2 font-medium"
          href="/blog"
        >
          Browse the blog
        </a>
      </section>
    </BaseLayout>
  )
}
