---
import { CACHE_CONTROL } from '@/utils/cache-control'
import { latestIsoDate, toIsoDate } from '@/utils/date'
import { getDefaultProfileOgUrl } from '@/utils/default-profile-og'
import { serializeJsonLd } from '@/utils/json-ld'
import { SITE_DOMAIN } from '@/utils/meta'
import {
  getAdjacentPosts,
  getPostBySlug,
  getRedirectByFrom,
  getRelatedPosts,
} from '@/utils/sanity.queries'
import GuideTrail from '@/components/GuideTrail.astro'
import PortableText from '@/components/PortableText.astro'
import PostAdjacentNav from '@/components/PostAdjacentNav.astro'
import PostEvidence from '@/components/PostEvidence.astro'
import RelatedPosts from '@/components/RelatedPosts.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import {
  formatDate,
  getSanityImageSrcSet,
  getSanityImageUrl,
} from '@/lib/sanity/helpers'
import { urlFor } from '@/lib/sanity/image'
import { getPostUpdatedDisplay } from '@/lib/sanity/post-display'
import { getRequestSanityClient } from '@/lib/sanity/preview-client'
import {
  createArticleSchema,
  createBreadcrumbSchema,
} from '@/lib/sanity/schema'

export const prerender = false

const { client: contentClient, isPreview } = getRequestSanityClient(
  Astro.request
)
Astro.response.headers.set(
  'Cache-Control',
  isPreview ? 'private, no-store' : CACHE_CONTROL.blogPost
)
const { slug } = Astro.params
if (!slug) return Astro.redirect('/blog', 302)

let post: Awaited<ReturnType<typeof getPostBySlug>> = null
let postUnavailable = false
try {
  post = await getPostBySlug(slug, contentClient)
} catch {
  postUnavailable = true
  Astro.response.status = 503
  Astro.response.headers.set('Cache-Control', 'no-store')
}
if (!post && !postUnavailable) {
  try {
    const redirect = await getRedirectByFrom(`/blog/${slug}`)
    if (redirect)
      return Astro.redirect(
        redirect.to,
        redirect.permanent === false ? 302 : 301
      )
  } catch {
    postUnavailable = true
    Astro.response.status = 503
    Astro.response.headers.set('Cache-Control', 'no-store')
  }
  if (!postUnavailable) Astro.response.status = 410
}

const topicIds = post?.topics.map((topic) => topic._id) ?? []
let relatedPosts: Awaited<ReturnType<typeof getRelatedPosts>> = []
let adjacent: Awaited<ReturnType<typeof getAdjacentPosts>> = {
  prev: null,
  next: null,
}
if (post) {
  try {
    const [nextRelatedPosts, nextAdjacent] = await Promise.all([
      getRelatedPosts(post._id, topicIds, 3, contentClient),
      getAdjacentPosts(post.date, post._createdAt, contentClient),
    ])
    relatedPosts = nextRelatedPosts
    adjacent = nextAdjacent
  } catch {
    // The article itself is still useful when optional navigation is unavailable.
  }
}
const updatedMeta = post ? getPostUpdatedDisplay(post) : null
const modifiedTime = post
  ? latestIsoDate([post.lastModified, post._updatedAt, post.date])
  : undefined
const publishedTime = post ? toIsoDate(post.date) : undefined
const imageUrl = post ? getSanityImageUrl(post.image, 1200, 630) : null
const ogImageUrl = post?.image
  ? urlFor(post.image).width(1200).height(630).quality(80).format('jpg').url()
  : null
const imageAlt = post
  ? (post.imageAlt ?? post.image?.alt ?? `Cover image for ${post.title}`)
  : undefined
const heroSrcSet = post
  ? getSanityImageSrcSet(post.image, [640, 768, 1024, 1280, 1600])
  : null
const canonicalUrl = `${SITE_DOMAIN}/blog/${slug}`
const defaultImageUrl = getDefaultProfileOgUrl()
const articleSchema = post ? createArticleSchema(post, defaultImageUrl) : null
const breadcrumbSchema = post
  ? createBreadcrumbSchema([
      { name: 'Home', url: SITE_DOMAIN },
      { name: 'Blog', url: `${SITE_DOMAIN}/blog` },
      { name: post.title, url: canonicalUrl },
    ])
  : null
---

{
  post && !postUnavailable ? (
    <BaseLayout
      title={post.title}
      description={post.description}
      url={canonicalUrl}
      image={ogImageUrl ?? undefined}
      imageAlt={imageAlt}
      type="article"
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      keywords={post.topics.map((topic) => topic.title)}
      preconnectSanity={true}
    >
      <script
        is:inline
        type="application/ld+json"
        set:html={serializeJsonLd(articleSchema)}
      />
      <script
        is:inline
        type="application/ld+json"
        set:html={serializeJsonLd(breadcrumbSchema)}
      />
      <article class="mx-auto max-w-3xl px-4 py-12">
        {imageUrl && (
          <div class="-mx-4 mb-8 sm:-mx-6">
            <div class="bg-muted relative aspect-video w-full overflow-hidden rounded-lg">
              <img
                src={imageUrl}
                srcset={heroSrcSet ?? undefined}
                sizes="(min-width: 1280px) 1200px, (min-width: 768px) 768px, 100vw"
                alt={imageAlt}
                class="absolute inset-0 h-full w-full object-cover"
                fetchpriority="high"
                loading="eager"
                decoding="async"
                width={1200}
                height={675}
              />
            </div>
          </div>
        )}
        <header class="mb-8 text-center">
          {post.topics?.length > 0 && (
            <div class="mb-4 flex flex-wrap justify-center gap-2">
              {post.topics.map((topic) => (
                <a
                  href={`/topics/${topic.slug.current}`}
                  class="bg-secondary text-secondary-foreground rounded-full px-3 py-1 text-xs font-medium hover:underline"
                >
                  {topic.title}
                </a>
              ))}
            </div>
          )}
          <>
            <h1 class="text-4xl font-bold tracking-tight">{post.title}</h1>
            <p class="text-muted-foreground mt-4 text-xl">{post.description}</p>
          </>
          <div class="text-muted-foreground mt-4 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-sm">
            <span>
              Published{' '}
              <time datetime={publishedTime}>{formatDate(post.date)}</time>
            </span>
            {post.author ? (
              <>
                <span aria-hidden="true">·</span>
                <a
                  class="hover:underline"
                  href={`/authors/${post.author.slug.current}`}
                >
                  By {post.author.name}
                </a>
              </>
            ) : null}
            {updatedMeta ? (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  Updated{' '}
                  <time datetime={updatedMeta.datetime}>
                    {updatedMeta.label}
                  </time>
                </span>
              </>
            ) : null}
            {post.readingTime ? (
              <>
                <span aria-hidden="true">·</span>
                <span>{post.readingTime} min read</span>
              </>
            ) : null}
          </div>
        </header>
        <>
          <GuideTrail postSlug={post.slug.current} />
          <PortableText value={post.body} />
          <PostEvidence
            sources={post.sources}
            reproduction={post.reproduction}
            versionScope={post.versionScope}
          />
        </>
      </article>
      <div class="mx-auto max-w-3xl px-4 pb-16">
        <>
          <PostAdjacentNav prev={adjacent.prev} next={adjacent.next} />
          <RelatedPosts posts={relatedPosts} />
        </>
      </div>
    </BaseLayout>
  ) : (
    <BaseLayout
      title={
        postUnavailable
          ? 'Article temporarily unavailable'
          : 'Article no longer available'
      }
      description={
        postUnavailable
          ? 'This article could not be loaded right now.'
          : "This article was retired because it no longer met loke.dev's editorial standards."
      }
      url={canonicalUrl}
      noindex={true}
    >
      <section class="mx-auto max-w-2xl px-4 py-24 text-center">
        <>
          <p class="text-accent text-sm font-semibold tracking-wider uppercase">
            {postUnavailable ? 'Try again soon' : '410 · Gone'}
          </p>
          <h1 class="mt-3 text-4xl font-bold">
            {postUnavailable
              ? 'This article is taking a short break.'
              : 'This article has been retired.'}
          </h1>
          <p class="text-muted-foreground mt-4 text-lg">
            {postUnavailable
              ? 'The content service did not respond. Please try again in a moment.'
              : 'It no longer met our editorial standards. Browse the current, maintained guides instead.'}
          </p>
          <a
            class="bg-primary text-primary-foreground mt-8 inline-flex rounded-md px-4 py-2 font-medium"
            href="/blog"
          >
            Browse the blog
          </a>
        </>
      </section>
    </BaseLayout>
  )
}
