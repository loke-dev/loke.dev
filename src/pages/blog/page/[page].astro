---
import { CACHE_CONTROL } from '@/utils/cache-control'
import { latestIsoDate } from '@/utils/date'
import { serializeJsonLd } from '@/utils/json-ld'
import { SITE_DOMAIN } from '@/utils/meta'
import {
  getBlogPage,
  getPaginatedPosts,
  POSTS_PER_PAGE,
  type BlogPage,
} from '@/utils/sanity.queries'
import BlogListSection from '@/components/BlogListSection.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

export const prerender = false

Astro.response.headers.set('Cache-Control', CACHE_CONTROL.blogIndex)

const pageParam = Astro.params.page
const currentPage = Number.parseInt(pageParam ?? '', 10)

if (
  !Number.isSafeInteger(currentPage) ||
  currentPage < 2 ||
  String(currentPage) !== pageParam
) {
  return Astro.redirect('/blog', 302)
}

const fallbackPage: BlogPage = {
  title: 'Blog',
  description: 'Practical notes from the Loke.dev workshop.',
}
let page = fallbackPage
let posts = [] as Awaited<ReturnType<typeof getPaginatedPosts>>['posts']
let totalCount = 0
let totalPages = 1
let contentUnavailable = false
try {
  const [paginatedResult, loadedPage] = await Promise.all([
    getPaginatedPosts(currentPage),
    getBlogPage(),
  ])
  page = loadedPage ?? fallbackPage
  posts = paginatedResult.posts
  totalCount = paginatedResult.totalCount
  totalPages = paginatedResult.totalPages
} catch {
  contentUnavailable = true
  Astro.response.status = 503
  Astro.response.headers.set('Cache-Control', 'no-store')
}
const modifiedTime = latestIsoDate([
  page._updatedAt,
  ...posts.flatMap((post) => [post.lastModified, post._updatedAt, post.date]),
])

if (!contentUnavailable && currentPage > totalPages) {
  return Astro.redirect('/blog', 302)
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_DOMAIN },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: `${SITE_DOMAIN}/blog`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: `Page ${currentPage}`,
      item: `${SITE_DOMAIN}/blog/page/${currentPage}`,
    },
  ],
}

const url = `${SITE_DOMAIN}/blog/page/${currentPage}`
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${page.title}, page ${currentPage}`,
  description: page.description,
  url,
  mainEntity: {
    '@type': 'ItemList',
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    numberOfItems: totalCount,
    itemListElement: posts.map((post, index) => ({
      '@type': 'ListItem',
      position: (currentPage - 1) * POSTS_PER_PAGE + index + 1,
      name: post.title,
      url: `${SITE_DOMAIN}/blog/${post.slug.current}`,
    })),
  },
}
---

<BaseLayout
  title={contentUnavailable
    ? 'Blog temporarily unavailable'
    : `Blog, page ${currentPage}`}
  description={contentUnavailable
    ? 'This blog archive page could not be loaded right now.'
    : `More practical technical guides from loke.dev. This is page ${currentPage} of the blog archive.`}
  url={url}
  modifiedTime={modifiedTime}
  preconnectSanity={true}
  noindex={contentUnavailable}
>
  {
    !contentUnavailable && (
      <link
        slot="head"
        rel="prev"
        href={`${SITE_DOMAIN}${currentPage === 2 ? '/blog' : `/blog/page/${currentPage - 1}`}`}
      />
    )
  }
  {
    !contentUnavailable && currentPage < totalPages && (
      <link
        slot="head"
        rel="next"
        href={`${SITE_DOMAIN}/blog/page/${currentPage + 1}`}
      />
    )
  }
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(breadcrumbSchema)}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(collectionSchema)}
  />

  {
    contentUnavailable ? (
      <section class="mx-auto max-w-2xl px-4 py-24 text-center">
        <p class="text-accent text-sm font-semibold tracking-wider uppercase">
          Try again soon
        </p>
        <h1 class="mt-3 text-4xl font-bold">
          This archive page is taking a short break.
        </h1>
        <p class="text-muted-foreground mt-4 text-lg">
          The content service did not respond. Please try again in a moment.
        </p>
      </section>
    ) : (
      <BlogListSection
        page={page}
        posts={posts}
        currentPage={currentPage}
        totalPages={totalPages}
      />
    )
  }
</BaseLayout>
