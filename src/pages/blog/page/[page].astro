---
import { CACHE_CONTROL } from '@/utils/cache-control'
import { SITE_DOMAIN } from '@/utils/meta'
import { getBlogPage, getPaginatedPosts } from '@/utils/sanity.queries'
import BlogListSection from '@/components/BlogListSection.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

export const prerender = false

Astro.response.headers.set('Cache-Control', CACHE_CONTROL.blogIndex)

const pageParam = Astro.params.page
const currentPage = Number.parseInt(pageParam ?? '', 10)

if (
  !Number.isSafeInteger(currentPage) ||
  currentPage < 2 ||
  String(currentPage) !== pageParam
) {
  return Astro.redirect('/blog', 302)
}

const [paginatedResult, page] = await Promise.all([
  getPaginatedPosts(currentPage),
  getBlogPage(),
])

const { posts, totalPages } = paginatedResult

if (currentPage > totalPages) {
  return Astro.redirect('/blog', 302)
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_DOMAIN },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Blog',
      item: `${SITE_DOMAIN}/blog`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: `Page ${currentPage}`,
      item: `${SITE_DOMAIN}/blog/page/${currentPage}`,
    },
  ],
}
---

<BaseLayout
  title={`Blog, page ${currentPage}`}
  description={`More practical technical guides from loke.dev. This is page ${currentPage} of the blog archive.`}
  url={`${SITE_DOMAIN}/blog/page/${currentPage}`}
  preconnectSanity={true}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <BlogListSection
    page={page}
    posts={posts}
    currentPage={currentPage}
    totalPages={totalPages}
  />
</BaseLayout>
