---
import { CACHE_CONTROL } from '@/utils/cache-control'
import { serializeJsonLd } from '@/utils/json-ld'
import { SITE_DOMAIN } from '@/utils/meta'
import { getProjectsPage } from '@/utils/sanity.queries'
import ProjectCard from '@/components/ProjectCard.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { client } from '@/lib/sanity/client'
import { PROJECTS_QUERY } from '@/lib/sanity/queries'
import type { Project } from '@/lib/sanity/types'

export const prerender = true

Astro.response.headers.set('Cache-Control', CACHE_CONTROL.staticPage)

const [projects, page] = await Promise.all([
  client.fetch<Project[]>(PROJECTS_QUERY),
  getProjectsPage(),
])

const featuredProjects = projects.filter((p) => p.featured)
const templates = projects.filter((p) => p.kind === 'template')
const otherProjects = projects.filter(
  (p) => !p.featured && p.kind !== 'template'
)

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_DOMAIN },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Projects',
      item: `${SITE_DOMAIN}/projects`,
    },
  ],
}

const projectSchemas = projects.map((project) => ({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: project.title,
  description: project.description,
  url: project.url,
  applicationCategory: 'WebApplication',
}))
---

<BaseLayout
  title="Projects"
  description="A selection of apps, websites, tools, and open-source templates made by Loke."
  url={`${SITE_DOMAIN}/projects`}
  preconnectSanity={true}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(breadcrumbSchema)}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(projectSchemas)}
  />

  <div class="workshop-page">
    <section class="grid gap-8 lg:grid-cols-[1fr_0.82fr] lg:items-end">
      <div>
        <p class="workshop-label">Selected work / Project board</p><h1
          class="workshop-heading mt-5"
        >
          {page.title}
        </h1>
      </div>
      <p class="text-muted-foreground max-w-xl text-lg leading-relaxed">
        {page.description}
      </p>
    </section>

    {
      featuredProjects.length > 0 && (
        <section class="mt-16 mb-24">
          <p class="workshop-label">01 / Projects</p>
          <h2 class="mt-3 mb-7 text-2xl font-bold md:text-3xl">
            {page.featuredSectionTitle}
          </h2>
          <div class="flex flex-col gap-6 md:gap-8">
            {featuredProjects.map((project) => (
              <ProjectCard project={project} featured={true} />
            ))}
          </div>
        </section>
      )
    }

    {
      otherProjects.length > 0 && (
        <section class="workshop-rule mb-24 pt-12 md:pt-16">
          <p class="workshop-label">02 / More projects</p>
          <h2 class="mt-3 mb-7 text-2xl font-bold md:text-3xl">
            {page.otherSectionTitle}
          </h2>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            {otherProjects.map((project) => (
              <ProjectCard project={project} />
            ))}
          </div>
        </section>
      )
    }

    {
      templates.length > 0 && (
        <section class="signal-grid border-accent/35 relative overflow-hidden border bg-[#171715] px-5 py-10 sm:px-8 md:px-10 md:py-14">
          <div class="relative max-w-3xl">
            <p class="workshop-label">03 / Template shelf</p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl">
              {page.templatesSectionTitle || 'Pick a starting point'}
            </h2>
            <p class="text-muted-foreground mt-4 max-w-2xl leading-relaxed">
              A small collection of starters you can copy, pull apart, and make
              your own. Each has a live preview and the source code.
            </p>
          </div>
          <div class="relative mt-9 grid gap-6 md:grid-cols-2">
            {templates.map((project) => (
              <ProjectCard project={project} template={true} />
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>
