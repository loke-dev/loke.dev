---
import { CACHE_CONTROL } from '@/utils/cache-control'
import { SITE_DOMAIN } from '@/utils/meta'
import BaseLayout from '@/layouts/BaseLayout.astro'
import {
  fetchRecentRepoCommits,
  getGithubRepoConfig,
} from '@/lib/github.server'

export const prerender = true

Astro.response.headers.set('Cache-Control', CACHE_CONTROL.changelog)

const gh = getGithubRepoConfig()
const commits = gh ? await fetchRecentRepoCommits(gh.owner, gh.repo, 50) : []
const repoHref = gh ? `https://github.com/${gh.owner}/${gh.repo}` : null

function formatWhen(iso: string): string {
  return new Date(iso).toLocaleString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  })
}
---

<BaseLayout
  title="Changelog"
  description="Recent commits from the site's GitHub repository."
  url={`${SITE_DOMAIN}/changelog`}
>
  <div class="container mx-auto max-w-2xl px-4 py-12 md:py-16">
    <header class="border-border/80 mb-12 border-b pb-10">
      <h1 class="text-4xl font-bold tracking-tight md:text-5xl">Changelog</h1>
      <p class="text-muted-foreground mt-4 text-lg leading-relaxed">
        What actually landed in the repo. Subject lines plus the longer
        explanation when there is one.
        {
          gh ? (
            <>
              {' '}
              <span class="text-foreground/80">
                {gh.owner}/{gh.repo}
              </span>
            </>
          ) : null
        }
      </p>
      {
        repoHref && (
          <a
            href={repoHref}
            class="interactive-button border-border bg-background text-foreground hover:border-accent/40 hover:text-accent mt-6 inline-flex items-center gap-2 rounded-lg border px-4 py-2 text-sm font-medium transition-colors"
            target="_blank"
            rel="noopener noreferrer"
          >
            Repository on GitHub
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
              <polyline points="15 3 21 3 21 9" />
              <line x1="10" y1="14" x2="21" y2="3" />
            </svg>
          </a>
        )
      }
    </header>

    {
      !gh && (
        <p class="border-accent/40 bg-accent/5 text-muted-foreground rounded-xl border border-dashed p-6 leading-relaxed">
          Set <span class="text-foreground font-mono">GITHUB_OWNER</span> and{' '}
          <span class="text-foreground font-mono">GITHUB_REPO</span> in your
          environment to load commits. A{' '}
          <span class="text-foreground font-mono">GITHUB_TOKEN</span> unlocks a
          higher rate limit but is optional for public repos.
        </p>
      )
    }

    {
      gh && commits.length === 0 && (
        <p class="text-muted-foreground leading-relaxed">
          No commits returned. The repository might be private without a token,
          or the API rate limit was hit.
        </p>
      )
    }

    <ol class="mt-6 list-none space-y-0 p-0">
      {
        commits.map((c) => (
          <li class="border-border/70 relative border-b py-8 last:border-b-0 md:py-10">
            <div class="flex flex-col gap-4 md:flex-row md:gap-8">
              <div class="shrink-0 md:w-28">
                <time
                  datetime={c.committedAt}
                  class="text-muted-foreground text-sm font-medium tabular-nums"
                >
                  {formatWhen(c.committedAt)}
                </time>
              </div>
              <div class="min-w-0 flex-1 space-y-3">
                <h2 class="text-foreground text-lg leading-snug font-semibold tracking-tight md:text-xl">
                  {c.subject}
                </h2>
                {c.body ? (
                  <p class="text-muted-foreground text-sm leading-relaxed whitespace-pre-wrap md:text-base">
                    {c.body}
                  </p>
                ) : null}
                <div class="text-muted-foreground flex flex-wrap items-center gap-x-3 gap-y-1 pt-1 text-xs md:text-sm">
                  <a
                    href={c.url}
                    class="text-accent font-mono transition-colors hover:underline"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {c.sha}
                  </a>
                  <span aria-hidden="true" class="text-border">
                    ·
                  </span>
                  <span>{c.authorName}</span>
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>
