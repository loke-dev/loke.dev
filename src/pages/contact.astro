---
import { CACHE_CONTROL } from '@/utils/cache-control'
import { SITE_CONTACT_EMAIL, SITE_DOMAIN } from '@/utils/meta'
import { getContactPage } from '@/utils/sanity.queries'
import ContactForm from '@/components/ContactForm'
import PageIntro from '@/components/PageIntro.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

export const prerender = true

Astro.response.headers.set('Cache-Control', CACHE_CONTROL.contact)

const page = await getContactPage()
---

<BaseLayout
  title="Contact"
  description={page?.description ?? 'Get in touch with Loke.'}
  url={`${SITE_DOMAIN}/contact`}
  modifiedTime={page?._updatedAt}
  loadTurnstile={true}
>
  <div class="mx-auto max-w-2xl px-4 py-16 md:py-20">
    <PageIntro
      eyebrow="Start a conversation"
      title={page?.title ?? 'Contact'}
      description={page?.description}
      compact
    />

    <div class="mt-10">
      <ContactForm client:load />
    </div>

    {
      page?.alternativeContactTitle && (
        <div class="mt-12 border-t pt-8">
          <h2 class="mb-4 text-2xl font-bold">
            {page.alternativeContactTitle}
          </h2>
          {page.alternativeContactDescription && (
            <p class="text-muted-foreground">
              {page.alternativeContactDescription}
            </p>
          )}
          <div class="mt-5 flex flex-wrap gap-4">
            <a
              href={`mailto:${SITE_CONTACT_EMAIL}`}
              class="text-accent font-medium underline-offset-4 hover:underline"
            >
              Email me →
            </a>
            <a
              href="https://github.com/loke-dev"
              class="text-accent font-medium underline-offset-4 hover:underline"
            >
              GitHub →
            </a>
          </div>
        </div>
      )
    }
  </div>
</BaseLayout>
