---
import { CACHE_CONTROL } from '@/utils/cache-control'
import { serializeJsonLd } from '@/utils/json-ld'
import { SITE_DOMAIN } from '@/utils/meta'
import { getPostsByTopicSlug, getTopicBySlug } from '@/utils/sanity.queries'
import BlogPostCard from '@/components/BlogPostCard.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

export const prerender = false

Astro.response.headers.set('Cache-Control', CACHE_CONTROL.blogIndex)
const { slug } = Astro.params
const topicSlug = slug ?? ''
const topic = topicSlug ? await getTopicBySlug(topicSlug) : null
if (!topic) {
  Astro.response.status = 404
  Astro.response.headers.set('Cache-Control', 'no-store')
}
const posts = topic ? await getPostsByTopicSlug(topicSlug) : []
const url = `${SITE_DOMAIN}/topics/${topicSlug}`
const breadcrumbSchema = topic
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_DOMAIN },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Topics',
          item: `${SITE_DOMAIN}/topics`,
        },
        { '@type': 'ListItem', position: 3, name: topic.title, item: url },
      ],
    }
  : null
const collectionSchema = topic
  ? {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: `${topic.title} guides`,
      description: topic.description,
      url,
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: posts.slice(0, 10).map((post, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: post.title,
          url: `${SITE_DOMAIN}/blog/${post.slug.current}`,
        })),
      },
    }
  : null
---

{
  topic ? (
    <BaseLayout
      title={`${topic.title} guides`}
      description={topic.description}
      url={url}
      preconnectSanity={true}
    >
      <script
        is:inline
        type="application/ld+json"
        set:html={serializeJsonLd(breadcrumbSchema)}
      />
      <script
        is:inline
        type="application/ld+json"
        set:html={serializeJsonLd(collectionSchema)}
      />
      <section class="mx-auto max-w-6xl px-4 py-16">
        <p class="text-accent text-sm font-semibold tracking-wider uppercase">
          Topic
        </p>
        <h1 class="mt-2 text-4xl font-bold tracking-tight">{topic.title}</h1>
        <p class="text-muted-foreground mt-4 max-w-2xl text-lg">
          {topic.description}
        </p>
        {posts.length ? (
          <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <BlogPostCard post={post} />
            ))}
          </div>
        ) : (
          <p class="text-muted-foreground mt-10">
            Maintained guides for this topic are coming soon.
          </p>
        )}
      </section>
    </BaseLayout>
  ) : (
    <BaseLayout
      title="Topic not found"
      description="This topic does not exist or has been removed."
      url={url}
      noindex={true}
    >
      <section class="mx-auto max-w-2xl px-4 py-24 text-center">
        <p class="text-accent text-sm font-semibold tracking-wider uppercase">
          Error 404
        </p>
        <h1 class="mt-3 text-4xl font-bold">This topic is not here.</h1>
        <p class="text-muted-foreground mt-4 text-lg">
          It may have been renamed or removed. The blog has the current guides.
        </p>
        <a
          class="bg-primary text-primary-foreground mt-8 inline-flex rounded-md px-4 py-2 font-medium"
          href="/blog"
        >
          Browse the blog
        </a>
      </section>
    </BaseLayout>
  )
}
