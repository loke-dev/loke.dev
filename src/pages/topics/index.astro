---
import { CACHE_CONTROL } from '@/utils/cache-control'
import { latestIsoDate } from '@/utils/date'
import { serializeJsonLd } from '@/utils/json-ld'
import { SITE_DOMAIN } from '@/utils/meta'
import { getAllTopics } from '@/utils/sanity.queries'
import PageIntro from '@/components/PageIntro.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

export const prerender = false

Astro.response.headers.set('Cache-Control', CACHE_CONTROL.blogIndex)
let topics = [] as Awaited<ReturnType<typeof getAllTopics>>
let topicsUnavailable = false
try {
  topics = await getAllTopics()
} catch {
  // Keep the archive route usable when the CMS has a short-lived outage.
  topicsUnavailable = true
  Astro.response.headers.set('Cache-Control', 'no-store')
}
const url = `${SITE_DOMAIN}/topics`
const modifiedTime = latestIsoDate(topics.map((topic) => topic._updatedAt))

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Blog topics',
  description:
    'Posts grouped by subject, including AI, CMS work, web frameworks, cloud, and performance.',
  url,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: topics.map((topic, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: topic.title,
      url: `${SITE_DOMAIN}/topics/${topic.slug.current}`,
    })),
  },
}
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_DOMAIN },
    { '@type': 'ListItem', position: 2, name: 'Topics', item: url },
  ],
}
---

<BaseLayout
  title="Blog topics"
  description="Browse posts by subject, from AI and CMS work to frameworks, cloud, performance, and the usual web dev rabbit holes."
  url={url}
  modifiedTime={modifiedTime}
  noindex={topicsUnavailable}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(collectionSchema)}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(breadcrumbSchema)}
  />
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20">
    <PageIntro
      eyebrow="Explore the archive"
      title="Blog topics"
      description="A simple way to explore the writing by subject."
    />
    {
      topicsUnavailable ? (
        <p class="border-border bg-card text-muted-foreground mt-10 rounded-xl border p-6">
          Topics are temporarily unavailable. Please try again in a moment.
        </p>
      ) : topics.length ? (
        <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {topics.map((topic) => (
            <li>
              <a
                href={`/topics/${topic.slug.current}`}
                class="surface-interactive hover:border-accent/40 block h-full rounded-xl border p-6 transition-[transform,border-color,box-shadow] hover:-translate-y-0.5 hover:shadow-[0_20px_50px_-28px_oklch(72%_0.16_70/0.28)]"
              >
                <h2 class="text-xl font-bold tracking-tight">{topic.title}</h2>
                <p class="text-muted-foreground mt-3">{topic.description}</p>
                <span class="text-accent mt-5 inline-block text-sm font-medium">
                  Browse posts →
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-muted-foreground mt-10">Topics are being prepared.</p>
      )
    }
  </section>
</BaseLayout>
