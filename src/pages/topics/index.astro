---
import { CACHE_CONTROL } from '@/utils/cache-control'
import { serializeJsonLd } from '@/utils/json-ld'
import { SITE_DOMAIN } from '@/utils/meta'
import { getAllTopics } from '@/utils/sanity.queries'
import PageIntro from '@/components/PageIntro.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

export const prerender = false

Astro.response.headers.set('Cache-Control', CACHE_CONTROL.blogIndex)
const topics = await getAllTopics()
const url = `${SITE_DOMAIN}/topics`

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Developer topics',
  description:
    'Maintained technical guides grouped by the developer problems they solve.',
  url,
}
---

<BaseLayout
  title="Developer topics"
  description="Maintained technical guides grouped by practical developer problems, from package management and CI to performance and TypeScript."
  url={url}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(collectionSchema)}
  />
  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20">
    <PageIntro
      eyebrow="Explore the archive"
      title="Developer topics"
      description="A way to explore the technical writing by subject."
    />
    {
      topics.length ? (
        <ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {topics.map((topic) => (
            <li>
              <a
                href={`/topics/${topic.slug.current}`}
                class="surface-interactive hover:border-accent/40 block h-full rounded-xl border p-6 transition-[transform,border-color,box-shadow] hover:-translate-y-0.5 hover:shadow-[0_20px_50px_-28px_oklch(72%_0.16_70/0.28)]"
              >
                <h2 class="text-xl font-bold tracking-tight">{topic.title}</h2>
                <p class="text-muted-foreground mt-3">{topic.description}</p>
                <span class="text-accent mt-5 inline-block text-sm font-medium">
                  Browse guides →
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-muted-foreground mt-10">Topics are being prepared.</p>
      )
    }
  </section>
</BaseLayout>
