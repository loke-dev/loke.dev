---
import { CACHE_CONTROL } from '@/utils/cache-control'
import { serializeJsonLd } from '@/utils/json-ld'
import { SITE_DOMAIN } from '@/utils/meta'
import BaseLayout from '@/layouts/BaseLayout.astro'

export const prerender = true

Astro.response.headers.set('Cache-Control', CACHE_CONTROL.staticPage)

const services = [
  {
    number: '01',
    title: 'Websites that have a job',
    description:
      'Landing pages, company sites, online stores, and CMS-driven sites that explain the thing and make it easy to act.',
    outcomes: [
      'Content and page structure',
      'Responsive, accessible UI',
      'Good speed and search basics',
    ],
  },
  {
    number: '02',
    title: 'Web apps and full-stack products',
    description:
      'Dashboards, member areas, booking flows, SaaS products, and the backend bits that make them work.',
    outcomes: [
      'Frontend and backend work',
      'APIs, databases, and integrations',
      'A sensible first version to build on',
    ],
  },
  {
    number: '03',
    title: 'AI that helps with actual work',
    description:
      'AI features, internal tools, and automations for a real task. Not an AI button added just because it is trendy.',
    outcomes: [
      'Quick prototypes to test an idea',
      'Useful workflows and automations',
      'Human checks where they matter',
    ],
  },
  {
    number: '04',
    title: 'Smaller apps and odd ideas',
    description:
      'Mobile apps, desktop apps, Chrome extensions, internal tools, and the random useful thing that does not fit in a normal website.',
    outcomes: [
      'Browser extensions and integrations',
      'Mobile or desktop app work',
      'Small tools that save people time',
    ],
  },
]

const process = [
  [
    'Talk first',
    'We look at the problem, who it is for, and what would make it worth doing.',
  ],
  [
    'Make a plan',
    'We pick the smallest useful version, then sort out screens, content, and the technical bits.',
  ],
  [
    'Build it',
    'I ship in small pieces so you can see it, test it, and change direction before it gets expensive.',
  ],
]

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Loke.dev',
  url: `${SITE_DOMAIN}/services`,
  description:
    'Web development, web apps, ecommerce, software products, and practical AI work.',
  provider: { '@type': 'Person', name: 'Loke', url: `${SITE_DOMAIN}/about` },
  serviceType: [
    'Web development',
    'Ecommerce development',
    'Web application development',
    'Mobile app development',
    'Desktop app development',
    'AI implementation',
    'Chrome extension development',
  ],
}
---

<BaseLayout
  title="Services"
  description="Web development, web apps, ecommerce, mobile and desktop apps, Chrome extensions, and practical AI work from Loke.dev."
  url={`${SITE_DOMAIN}/services`}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(serviceSchema)}
  />

  <main class="workshop-page">
    <section class="grid gap-8 lg:grid-cols-[1fr_0.82fr] lg:items-end">
      <div>
        <p class="workshop-label">Services / Build room</p><h1
          class="workshop-heading mt-5"
        >
          I build software for the web, and the stuff around it.
        </h1>
      </div>
      <p class="text-muted-foreground max-w-xl text-lg leading-relaxed">
        Need a new site, an app, an online store, an AI feature, or a small tool
        that saves time? I can help get it made.
      </p>
    </section>

    <section class="mt-16 grid gap-4 md:grid-cols-2" aria-label="Services">
      {
        services.map((service) => (
          <article class="workshop-card surface-interactive hover:border-accent/40 p-6 transition-[transform,border-color,box-shadow] hover:-translate-y-1">
            <p class="workshop-number">{service.number}</p>
            <h2 class="mt-5 text-2xl font-bold tracking-tight">
              {service.title}
            </h2>
            <p class="text-muted-foreground mt-4 leading-relaxed">
              {service.description}
            </p>
            <ul class="border-border/70 text-muted-foreground mt-6 space-y-3 border-t pt-5 text-sm">
              {service.outcomes.map((outcome) => (
                <li class="flex gap-3">
                  <span class="text-accent" aria-hidden="true">
                    →
                  </span>
                  {outcome}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section class="workshop-rule mt-24 pt-10 md:pt-12">
      <p class="workshop-label">How I work</p>
      <div class="mt-5 grid gap-8 md:grid-cols-3">
        {
          process.map(([title, description], index) => (
            <article>
              <p class="workshop-number">0{index + 1}</p>
              <h2 class="mt-3 text-xl font-bold">{title}</h2>
              <p class="text-muted-foreground mt-3 leading-relaxed">
                {description}
              </p>
            </article>
          ))
        }
      </div>
    </section>

    <section
      class="paper-panel mt-20 border border-[#121212]/15 px-6 py-10 md:flex md:items-end md:justify-between md:px-10"
    >
      <div class="max-w-2xl">
        <p
          class="font-mono text-xs font-bold tracking-[0.16em] text-[#ff5a1f] uppercase"
        >
          A good first conversation
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-[#121212]">
          Got something you want to make?
        </h2>
        <p class="mt-4 leading-relaxed text-[#5d5a54]">
          Send a short note about the idea, what you have today, and where you
          are stuck. That is enough to start.
        </p>
      </div>
      <a
        href="/contact"
        class="interactive-button mt-7 inline-flex items-center justify-center bg-[#121212] px-5 py-3 font-mono text-sm font-bold tracking-wide text-[#f4f0e8] uppercase transition-transform md:mt-0"
      >
        Start a conversation →
      </a>
    </section>
  </main>
</BaseLayout>
