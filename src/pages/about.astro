---
import { CACHE_CONTROL } from '@/utils/cache-control'
import { serializeJsonLd } from '@/utils/json-ld'
import { SITE_DOMAIN } from '@/utils/meta'
import { getAboutPage } from '@/utils/sanity.queries'
import PortableText from '@/components/PortableText.astro'
import profilePortrait256 from '@/assets/loke-workshop-signal-portrait-256.png'
import profilePortrait512 from '@/assets/loke-workshop-signal-portrait-512.png'
import BaseLayout from '@/layouts/BaseLayout.astro'

export const prerender = true

Astro.response.headers.set('Cache-Control', CACHE_CONTROL.staticPage)

const page = await getAboutPage()
const profileSizes = '(min-width: 768px) 320px, 240px'
const profilePortraitSrcset = `${profilePortrait256.src} 256w, ${profilePortrait512.src} 512w`

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_DOMAIN },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'About',
      item: `${SITE_DOMAIN}/about`,
    },
  ],
}

const profileSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    '@id': `${SITE_DOMAIN}/#person`,
    name: 'Loke',
    url: `${SITE_DOMAIN}/about`,
    sameAs: ['https://github.com/loke-dev', 'https://twitter.com/loke_dev'],
  },
}
---

<BaseLayout
  title="About"
  description="About Loke, a developer building websites, apps, useful tools, and practical AI features."
  url={`${SITE_DOMAIN}/about`}
  preconnectSanity={true}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(breadcrumbSchema)}
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeJsonLd(profileSchema)}
  />

  <main class="workshop-page">
    <div class="grid gap-12 lg:grid-cols-[0.82fr_1.18fr] lg:items-start">
      <div class="lg:sticky lg:top-28">
        <p class="workshop-label">About / the person</p>
        <h1 class="workshop-heading mt-5">{page.title}</h1>
        <div class="paper-stack mt-10 max-w-xs">
          <div
            class="signal-grid border-accent/45 relative overflow-hidden border bg-[#171715] p-4"
          >
            <img
              src={profilePortrait512.src}
              srcset={profilePortraitSrcset}
              sizes={profileSizes}
              alt="Loke"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width={512}
              height={512}
              class="aspect-square w-full object-cover"
            />
            <p class="paper-panel mt-4 p-3 text-sm font-semibold">
              I make digital things that should be a bit easier to use than they
              were yesterday.
            </p>
          </div>
        </div>
      </div>
      <div class="prose prose-invert max-w-none">
        <p class="lead text-muted-foreground text-xl leading-relaxed">
          {page.intro}
        </p>
        <div class="workshop-rule mt-10 pt-1"></div>
        {
          page.sections?.map((section, index) => (
            <section class="mt-10">
              <>
                <p class="workshop-number">0{index + 1} / NOTES</p>
                <h2 class="mt-3 mb-4 text-3xl font-bold tracking-[-0.04em]">
                  {section.title}
                </h2>
                <PortableText value={section.content} />
              </>
            </section>
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>
