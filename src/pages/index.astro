---
import { CACHE_CONTROL } from '@/utils/cache-control'
import { SITE_DOMAIN } from '@/utils/meta'
import { getAllPublishedPosts, getHomePage } from '@/utils/sanity.queries'
import BlogPostCard from '@/components/BlogPostCard.astro'
import profilePortrait256 from '@/assets/loke-workshop-signal-portrait-256.png'
import profilePortrait512 from '@/assets/loke-workshop-signal-portrait-512.png'
import BaseLayout from '@/layouts/BaseLayout.astro'

export const prerender = true

Astro.response.headers.set('Cache-Control', CACHE_CONTROL.home)

const [allPosts, page] = await Promise.all([
  getAllPublishedPosts(),
  getHomePage(),
])
const latestPosts = allPosts.slice(0, 3)

const heroLcpSizes = '(min-width: 640px) 256px, 192px'
const profilePortraitSrcset = `${profilePortrait256.src} 256w, ${profilePortrait512.src} 512w`

const focusAreas = [
  {
    number: '01',
    title: 'Make the first impression useful',
    description:
      'Clear positioning, strong content hierarchy, and interfaces that make the next step obvious.',
  },
  {
    number: '02',
    title: 'Build for the long middle',
    description:
      'A maintainable system for the months after launch: content, performance, and the team using it.',
  },
  {
    number: '03',
    title: 'Use AI where it removes real friction',
    description:
      'Practical workflows and product features with review, guardrails, and a reason to exist.',
  },
]
---

<BaseLayout
  title="Independent web developer"
  description={page.heroDescription ?? 'Full-stack web developer.'}
  url={SITE_DOMAIN}
  preconnectSanity={true}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={profilePortrait512.src}
    imagesrcset={profilePortraitSrcset}
    imagesizes={heroLcpSizes}
    type="image/png"
    fetchpriority="high"
  />
  <div class="flex flex-col items-center">
    <section class="w-full max-w-6xl px-4 pt-12 pb-20 md:pt-20 md:pb-28">
      <div
        class="grid grid-cols-1 items-center gap-10 md:grid-cols-[1fr_0.88fr] md:gap-16"
      >
        <div>
          <p class="signal-eyebrow mb-6">Independent developer / Sweden</p>
          <h1
            class="max-w-3xl font-mono text-5xl leading-[0.96] font-bold tracking-[-0.09em] md:text-7xl lg:text-8xl"
          >
            Build useful<br />
            <span class="text-accent">things</span>, then<br />
            make them stick.
          </h1>
          <p
            class="text-muted-foreground mt-7 max-w-xl text-lg leading-relaxed md:text-xl"
          >
            {
              page.heroDescription ??
                'Websites, software, AI work, and the systems that keep them useful after launch.'
            }
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="/services"
              class="interactive-button bg-accent text-accent-foreground hover:bg-accent/85 inline-flex items-center justify-center rounded-sm px-6 py-3 font-mono text-sm font-bold tracking-wide uppercase shadow-[0_14px_36px_-20px_rgb(255_90_31/0.65)] transition-[transform,background-color,box-shadow] duration-200"
            >
              Work with me →
            </a>
            <a
              href="/projects"
              class="interactive-button border-border bg-card hover:border-accent/70 hover:bg-secondary inline-flex items-center justify-center rounded-sm border px-6 py-3 font-mono text-sm font-bold tracking-wide uppercase transition-[transform,background-color,border-color,box-shadow] duration-200"
            >
              See the work
            </a>
          </div>
        </div>
        <div class="relative py-5">
          <div
            class="hero-frame signal-grid border-accent/45 relative min-h-[27rem] overflow-hidden rounded-sm border bg-[#171715] p-5 shadow-[0_32px_90px_-48px_rgb(0_0_0/0.95)]"
          >
            <div
              class="absolute top-5 right-5 font-mono text-[0.65rem] font-bold tracking-[0.16em] text-[#f4f0e8]/70 uppercase"
            >
              <p>Signal / 001</p>
              <p class="text-accent mt-1">live system</p>
            </div>
            <aside
              class="paper-panel absolute top-5 left-5 z-10 max-w-44 rotate-[-2deg] border border-[#121212]/20 p-3 shadow-xl"
            >
              <p
                class="font-mono text-[0.62rem] font-bold tracking-[0.16em] text-[#ff5a1f] uppercase"
              >
                Working note / 01
              </p>
              <p class="mt-2 text-xs leading-relaxed text-[#121212]">
                Make the useful bit easy to find. Do the boring bit properly.
              </p>
            </aside>
            <a
              href="/services"
              data-astro-prefetch="hover"
              class="hero-focus-panel paper-panel hover:border-accent/70 focus-visible:border-accent absolute right-5 bottom-5 left-5 border border-[#121212]/15 p-4"
            >
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p
                    class="font-mono text-[0.65rem] font-bold tracking-[0.16em] text-[#ff5a1f] uppercase"
                  >
                    Current focus / 2026
                  </p>
                  <p class="mt-2 text-sm font-semibold text-[#121212]">
                    Fast sites, simple systems, AI that helps.
                  </p>
                </div>
                <span
                  class="border-accent text-accent hero-focus-panel__arrow grid h-9 w-9 place-items-center rounded-full border"
                  aria-hidden="true">↗</span
                >
              </div>
            </a>
            <div
              class="absolute top-[45%] left-1/2 -translate-x-1/2 -translate-y-1/2"
            >
              <div
                class="border-accent/70 relative h-48 w-48 overflow-hidden rounded-full border-2 bg-[#121212] shadow-[0_0_0_12px_rgb(255_90_31/0.1)] sm:h-56 sm:w-56"
              >
                <img
                  src={profilePortrait512.src}
                  srcset={profilePortraitSrcset}
                  sizes={heroLcpSizes}
                  alt="Loke"
                  fetchpriority="high"
                  loading="eager"
                  decoding="async"
                  width={512}
                  height={512}
                  class="h-full w-full object-cover"
                />
              </div>
            </div>
            <div class="bg-accent absolute bottom-0 left-0 h-1 w-2/3"></div>
          </div>
        </div>
      </div>
    </section>

    <section
      class="border-border/70 bg-muted/35 w-full border-y py-16 md:py-20"
    >
      <div class="container mx-auto max-w-6xl px-4">
        <div class="grid gap-8 md:grid-cols-[0.75fr_1.25fr] md:items-end">
          <div>
            <p
              class="text-accent text-xs font-semibold tracking-[0.2em] uppercase"
            >
              A practical stack
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight">
              Tools are only useful if they make the work easier.
            </h2>
          </div>
          <p class="text-muted-foreground max-w-xl">
            The stuff I use for websites, content, and the parts behind the
            scenes.
          </p>
        </div>
        <div class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-6">
          {
            page.technologies.map((tech) => (
              <div class="surface-interactive border-border/70 bg-background/70 hover:border-accent/35 flex h-20 items-center justify-center rounded-lg border p-4 text-center shadow-sm transition-[transform,box-shadow,border-color] duration-200">
                <span class="font-medium">{tech}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="w-full max-w-6xl px-4 py-20 md:py-28">
      <div class="grid gap-10 md:grid-cols-[0.8fr_1.2fr]">
        <div>
          <p
            class="text-accent text-xs font-semibold tracking-[0.2em] uppercase"
          >
            What I can help with
          </p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight">
            Websites and tools that do not turn into a mess later.
          </h2>
          <p class="text-muted-foreground mt-4 max-w-md leading-relaxed">
            A new website, a CMS that is getting messy, or an AI feature that
            needs to be useful. The point is fewer weird problems later.
          </p>
          <a
            href="/services"
            class="text-accent mt-6 inline-flex text-sm font-semibold underline-offset-4 hover:underline"
            >How I work →</a
          >
        </div>
        <div class="grid gap-3 sm:grid-cols-3 md:pt-10">
          {
            focusAreas.map((area) => (
              <article class="border-border/80 bg-card rounded-xl border p-5 sm:even:translate-y-8">
                <p class="text-accent text-xs font-semibold tracking-[0.2em]">
                  {area.number}
                </p>
                <h3 class="mt-10 text-lg leading-snug font-bold">
                  {area.title}
                </h3>
                <p class="text-muted-foreground mt-3 text-sm leading-relaxed">
                  {area.description}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="w-full max-w-6xl px-4 py-20" id="blog">
      <div class="border-border/70 mb-12 border-b pb-8">
        <p class="text-accent text-xs font-semibold tracking-[0.2em] uppercase">
          Field notes
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight">
          {page.blogSectionTitle}
        </h2>
        <p class="text-muted-foreground mt-3 max-w-2xl">
          {page.blogSectionDescription}
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        {
          latestPosts.map((post) => (
            <BlogPostCard post={post} imageWidth={500} imageHeight={281} />
          ))
        }
      </div>

      <div class="mt-12">
        <a
          href="/blog"
          aria-label="View All Articles"
          class="interactive-button bg-primary text-primary-foreground hover:bg-primary/90 inline-flex items-center justify-center rounded-md px-6 py-3 text-base font-medium shadow-[0_12px_32px_-16px_oklch(72%_0.2_70/0.4)] transition-[transform,background-color,box-shadow] duration-200"
        >
          View All Articles
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            class="ml-2"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </section>

    <section class="w-full px-4 pb-20 md:pb-28">
      <div
        class="border-accent/25 from-accent/15 via-card to-card mx-auto max-w-6xl rounded-2xl border bg-gradient-to-br px-6 py-10 md:flex md:items-end md:justify-between md:px-10"
      >
        <div class="max-w-2xl">
          <p
            class="text-accent text-xs font-semibold tracking-[0.2em] uppercase"
          >
            A useful next step
          </p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight">
            {page.ctaTitle}
          </h2>
          <p class="text-muted-foreground mt-4 leading-relaxed">
            {page.ctaDescription}
          </p>
        </div>
        <a
          href="/contact"
          class="interactive-button bg-primary text-primary-foreground hover:bg-primary/90 mt-7 inline-flex items-center justify-center rounded-md px-5 py-3 text-sm font-medium transition-[transform,background-color,box-shadow] duration-200 md:mt-0"
        >
          {page.ctaButtonText}
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
