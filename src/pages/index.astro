---
import { CACHE_CONTROL } from '@/utils/cache-control'
import { SITE_DOMAIN } from '@/utils/meta'
import { getAllPublishedPosts, getHomePage } from '@/utils/sanity.queries'
import BlogPostCard from '@/components/BlogPostCard.astro'
import profilePortrait256 from '@/assets/loke-workshop-signal-portrait-256.png'
import profilePortrait512 from '@/assets/loke-workshop-signal-portrait-512.png'
import BaseLayout from '@/layouts/BaseLayout.astro'

export const prerender = true

Astro.response.headers.set('Cache-Control', CACHE_CONTROL.home)

const [allPosts, page] = await Promise.all([
  getAllPublishedPosts(),
  getHomePage(),
])
const latestPosts = allPosts.slice(0, 3)

const heroLcpSizes = '(min-width: 640px) 256px, 192px'
const profilePortraitSrcset = `${profilePortrait256.src} 256w, ${profilePortrait512.src} 512w`

const focusAreas = [
  {
    number: '01',
    title: 'Make the first impression useful',
    description:
      'Clear positioning, strong content hierarchy, and interfaces that make the next step obvious.',
  },
  {
    number: '02',
    title: 'Build for the long middle',
    description:
      'A maintainable system for the months after launch: content, performance, and the team using it.',
  },
  {
    number: '03',
    title: 'Use AI where it removes real friction',
    description:
      'Practical workflows and product features with review, guardrails, and a reason to exist.',
  },
]
---

<BaseLayout
  title="Independent web developer"
  description={page.heroDescription ?? 'Full-stack web developer.'}
  url={SITE_DOMAIN}
  preconnectSanity={true}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={profilePortrait512.src}
    imagesrcset={profilePortraitSrcset}
    imagesizes={heroLcpSizes}
    type="image/png"
    fetchpriority="high"
  />
  <main>
    <section class="workshop-page pt-12 md:pt-20">
      <div class="grid items-center gap-12 lg:grid-cols-[1.08fr_0.92fr]">
        <div>
          <p class="workshop-label">Workshop signal / Sweden</p>
          <h1 class="workshop-heading mt-6">
            Make the <span class="text-accent">useful</span> thing.
          </h1>
          <p
            class="text-muted-foreground mt-7 max-w-xl text-lg leading-relaxed md:text-xl"
          >
            {
              page.heroDescription ??
                'Websites, software and AI work that are clear to use, quick to load, and easier to live with after launch.'
            }
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a
              href="/contact"
              class="interactive-button bg-accent text-accent-foreground hover:bg-accent/85 inline-flex items-center justify-center px-6 py-3 font-mono text-sm font-bold tracking-wide uppercase transition-[transform,background-color]"
            >
              Start a project ↗
            </a>
            <a
              href="/projects"
              class="interactive-button border-border bg-card hover:border-accent/70 inline-flex items-center justify-center border px-6 py-3 font-mono text-sm font-bold tracking-wide uppercase transition-[transform,border-color]"
            >
              See what I make
            </a>
          </div>
          <div
            class="workshop-rule text-muted-foreground mt-12 grid gap-4 pt-6 text-sm sm:grid-cols-3"
          >
            <p>
              <span class="text-foreground block font-mono">WEB / APPS</span
              >Built from idea to launch
            </p>
            <p>
              <span class="text-foreground block font-mono">AI / SYSTEMS</span
              >Useful, checked, and simple
            </p>
            <p>
              <span class="text-foreground block font-mono"
                >STOCKHOLM / REMOTE</span
              >Working with good people
            </p>
          </div>
        </div>

        <div class="paper-stack mx-auto w-full max-w-md">
          <div
            class="signal-grid border-accent/45 relative min-h-[31rem] overflow-hidden border bg-[#171715] p-5 shadow-[0_34px_100px_-52px_rgb(0_0_0/0.95)]"
          >
            <p
              class="absolute top-5 right-5 font-mono text-[0.65rem] font-bold tracking-[0.16em] text-[#f4f0e8]/70 uppercase"
            >
              Signal / 001<br /><span class="text-accent">open for work</span>
            </p>
            <aside
              class="paper-panel absolute top-5 left-5 z-10 max-w-48 rotate-[-2deg] border border-[#121212]/20 p-4 shadow-xl"
            >
              <p
                class="font-mono text-[0.62rem] font-bold tracking-[0.16em] text-[#ff5a1f] uppercase"
              >
                Working note
              </p>
              <p class="mt-2 text-sm leading-relaxed text-[#121212]">
                Make the useful bit easy to find. Do the boring bit properly.
              </p>
            </aside>
            <div
              class="absolute top-[48%] left-1/2 -translate-x-1/2 -translate-y-1/2"
            >
              <div
                class="border-accent/70 relative h-52 w-52 overflow-hidden rounded-full border-2 bg-[#121212] shadow-[0_0_0_14px_rgb(255_90_31/0.1)] sm:h-60 sm:w-60"
              >
                <img
                  src={profilePortrait512.src}
                  srcset={profilePortraitSrcset}
                  sizes={heroLcpSizes}
                  alt="Loke"
                  fetchpriority="high"
                  loading="eager"
                  decoding="async"
                  width={512}
                  height={512}
                  class="h-full w-full object-cover"
                />
              </div>
            </div>
            <a
              href="/services"
              class="paper-panel absolute right-5 bottom-5 left-5 border border-[#121212]/15 p-4 transition-transform hover:-translate-y-1"
            >
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p
                    class="font-mono text-[0.62rem] font-bold tracking-[0.16em] text-[#ff5a1f] uppercase"
                  >
                    Current focus / 2026
                  </p><p class="mt-2 text-sm font-semibold text-[#121212]">
                    Fast sites. Small systems. AI that helps.
                  </p>
                </div><span class="text-accent text-xl" aria-hidden="true"
                  >↗</span
                >
              </div>
            </a>
            <div class="bg-accent absolute bottom-0 left-0 h-1 w-2/3"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="border-border/70 border-y bg-[#171715]/65">
      <div class="workshop-page py-16 md:py-20">
        <div class="grid gap-10 lg:grid-cols-[0.82fr_1.18fr]">
          <div>
            <p class="workshop-label">What I build</p><h2
              class="mt-5 max-w-md text-4xl font-bold tracking-[-0.06em] md:text-5xl"
            >
              A solid website is rarely just a website.
            </h2>
          </div>
          <div class="grid gap-3 sm:grid-cols-3">
            {
              focusAreas.map((area) => (
                <article class="workshop-card p-5 sm:even:translate-y-8">
                  <>
                    <p class="workshop-number">{area.number}</p>
                    <h3 class="mt-10 text-xl leading-tight font-bold">
                      {area.title}
                    </h3>
                    <p class="text-muted-foreground mt-4 text-sm leading-relaxed">
                      {area.description}
                    </p>
                  </>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="workshop-page">
      <div class="grid gap-10 lg:grid-cols-[1.05fr_0.95fr] lg:items-end">
        <div>
          <p class="workshop-label">Tools I reach for</p><h2
            class="mt-5 text-4xl font-bold tracking-[-0.06em] md:text-5xl"
          >
            Boring tech, used well.
          </h2><p class="text-muted-foreground mt-5 max-w-xl leading-relaxed">
            There is no perfect stack. I pick tools that fit the problem, keep
            the team moving, and do not become a mystery six months later.
          </p>
        </div>
        <div
          class="border-border/70 bg-border/70 grid grid-cols-2 gap-px overflow-hidden border sm:grid-cols-3"
        >
          {
            page.technologies.map((tech) => (
              <div class="bg-card px-4 py-6 text-center font-mono text-sm font-bold tracking-tight">
                {tech}
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="workshop-page pt-0" id="blog">
      <div
        class="workshop-rule grid gap-8 pt-10 md:grid-cols-[1fr_auto] md:items-end"
      >
        <div>
          <p class="workshop-label">Field notes</p><h2
            class="mt-5 text-4xl font-bold tracking-[-0.06em] md:text-5xl"
          >
            {page.blogSectionTitle}
          </h2><p class="text-muted-foreground mt-4 max-w-2xl leading-relaxed">
            {page.blogSectionDescription}
          </p>
        </div>
        <a href="/blog" class="workshop-link"
          >All notes <span aria-hidden="true">→</span></a
        >
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {
          latestPosts.map((post) => (
            <BlogPostCard post={post} imageWidth={500} imageHeight={281} />
          ))
        }
      </div>
    </section>

    <section class="workshop-page pt-0">
      <div class="paper-panel border border-[#121212]/15 p-7 md:p-10">
        <div class="grid gap-8 md:grid-cols-[1fr_auto] md:items-end">
          <div>
            <p
              class="font-mono text-xs font-bold tracking-[0.15em] text-[#ff5a1f] uppercase"
            >
              New signal
            </p><h2
              class="mt-4 max-w-2xl text-4xl font-bold tracking-[-0.06em] text-[#121212] md:text-5xl"
            >
              {page.ctaTitle}
            </h2><p class="mt-4 max-w-xl leading-relaxed text-[#5d5a54]">
              {page.ctaDescription}
            </p>
          </div><a
            href="/contact"
            class="inline-flex w-fit bg-[#121212] px-5 py-3 font-mono text-sm font-bold tracking-wide text-[#f4f0e8] uppercase transition-transform hover:-translate-y-1"
            >{page.ctaButtonText} ↗</a
          >
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
