{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loke-dev",
  "main": "./src/worker.ts",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "loke.dev",
      "custom_domain": true,
    },
  ],
  "compatibility_date": "2026-06-02",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
  },
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["45 23 * * *"],
  },
}
