{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loke-dev",
  "main": "./src/worker.ts",
  // The production custom domain is managed in Cloudflare and already points
  // to this Worker. Keep route lifecycle out of the deploy token's scope.
  "workers_dev": false,
  "compatibility_date": "2026-06-02",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
  },
  "observability": {
    "enabled": true,
  },
  "triggers": {
    // Keep scheduled events explicitly disabled; this Worker has no scheduled handler.
    "crons": [],
  },
}
